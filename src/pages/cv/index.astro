---
import { getCollection, render } from "astro:content"
import { getYangsAiResearchData } from "@/lib/yangsai"
import ArrowCard from "@/components/ArrowCard"
import PageLayout from "@/layouts/PageLayout.astro"
import TopLayout from "@/layouts/TopLayout.astro"
import BottomLayout from "@/layouts/BottomLayout.astro"
import { CV } from "@/consts"

const collection = await getCollection("cv")

const cv = await Promise.all(
  collection.filter(collection => !collection.data.draft).sort((a, b) => a.data.order - b.data.order).map(async (item) => {
    const { Content } = await render(item)
    return { ...item, Content }
  })
)

const { publications } = await getYangsAiResearchData()
const recentPublications = (publications.filter((publication) => publication.data.select).length > 0
  ? publications.filter((publication) => publication.data.select)
  : publications
).slice(0, 6)

---

<PageLayout title={CV.TITLE} description={CV.DESCRIPTION}>
  <TopLayout>
    <div class="animate page-heading">
      {CV.TITLE}
    </div>
  </TopLayout>
  <BottomLayout>
    <ul>
      { 
        cv.map((entry) => (
          <li class="animate border-b border-black/10 dark:border-white/25 mt-4 py-8 first-of-type:mt-0 first-of-type:pt-0 last-of-type:border-none">
            <div class="text-black dark:text-white font-semibold">
              {entry.data.title}
            </div>
            {entry.data.subtitle &&
              <div class="text-sm font-semibold">
              {entry.data.subtitle}
              </div>
            }
            {entry.id === "publications.md" ? (
              <div class="mt-4">
                <div class="text-sm uppercase mb-2 font-semibold tracking-wide">
                  Recent Research
                </div>
                <ul class="flex flex-col gap-3">
                  {recentPublications.map((publication) => (
                    <li>
                      <ArrowCard entry={publication} />
                    </li>
                  ))}
                </ul>
              </div>
            ) : (
              <article class="prose dark:prose-invert">
                <entry.Content />
              </article>
            )}
          </li>
        ))
      }
    </ul>
  </BottomLayout>
</PageLayout>