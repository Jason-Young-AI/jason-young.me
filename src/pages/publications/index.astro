---
import { PUBLICATIONS } from "@/consts"
import { getYangsAiResearchData } from "@/lib/yangsai"

import PageLayout from "@/layouts/PageLayout.astro"
import TopLayout from "@/layouts/TopLayout.astro"
import BottomLayout from "@/layouts/BottomLayout.astro"

import Publications from "@/components/Publications"


const { publications } = await getYangsAiResearchData()
---

<PageLayout title={PUBLICATIONS.TITLE} description={PUBLICATIONS.DESCRIPTION}>
  <TopLayout>
    <div class="animate page-heading">
      {PUBLICATIONS.TITLE}
    </div>
  </TopLayout>
  <BottomLayout>
    <div class="animate">
      <Publications client:load data={publications} />
    </div>
  </BottomLayout>
</PageLayout>