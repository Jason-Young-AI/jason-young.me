---
import { ClientRouter } from "astro:transitions"

interface Props {
  title: string
  description: string
  image?: string
  home?: boolean
  schema?: Record<string, unknown> | Array<Record<string, unknown>>
}

const { title, description, image = "/logos/logo-no-background.svg", home = false, schema } = Astro.props

const site = Astro.site ?? new URL(Astro.url).origin
const canonical = new URL(Astro.url.pathname, site).href

const exact_url = new URL(Astro.url.pathname + Astro.url.search + Astro.url.hash, site).href
const exact_image = new URL(image, site).href
const exact_title = home ? `Jason Young ( 杨郑鑫 / Zhengxin Yang ) – ${title}` : title
const exact_description = description?.match(/Jason Young|杨郑鑫|Zhengxin Yang/i) ? description : `${description} - Jason Young (杨郑鑫 / Zhengxin Yang)`
const pathSegments = Astro.url.pathname.split("/").filter(Boolean)
const isHiddenPage = Astro.url.pathname === "/hidden" || Astro.url.pathname.startsWith("/hidden/")

const breadcrumbItems = [
  {
    "@type": "ListItem",
    "position": 1,
    "name": "Home",
    "item": site,
  },
  ...pathSegments.map((segment, index) => ({
    "@type": "ListItem",
    "position": index + 2,
    "name": decodeURIComponent(segment).replace(/[-_]/g, " "),
    "item": new URL(pathSegments.slice(0, index + 1).join("/") + "/", site).href,
  })),
]

const exact_person = {
  "@context": "https://schema.org",
  "@type": "Person",
  "@id": `${site}#person`,
  "name": "杨郑鑫",
  "alternateName": ["Jason Young", "Zhengxin Yang"],
  "url": site,
  "sameAs": [
    "https://github.com/Jason-Young-AI",
    "https://www.linkedin.com/in/zhengxinyang/",
    "https://orcid.org/0000-0001-5969-0083"
  ],
  "worksFor": { "@id": `${site}#organization` },
  "description": "Jason Young (杨郑鑫 / Zhengxin Yang) - Personal Website"
}

const exact_organization = {
  "@context": "https://schema.org",
  "@type": "ResearchOrganization",
  "@id": `${site}#organization`,
  "name": "Jason Young Research",
  "url": site,
  "logo": {
    "@type": "ImageObject",
    "url": new URL("/logos/logo-no-background.svg", site).href,
  },
  "founder": { "@id": `${site}#person` },
  "sameAs": [
    "https://github.com/Jason-Young-AI",
    "https://www.linkedin.com/in/zhengxinyang/"
  ],
}

const exact_website = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": `${site}#website`,
  "url": site,
  "name": "Jason Young",
  "inLanguage": "en",
  "description": exact_description,
  "publisher": { "@id": `${site}#organization` },
}

const exact_webpage = {
  "@context": "https://schema.org",
  "@type": home ? "ProfilePage" : "WebPage",
  "@id": `${exact_url}#webpage`,
  "url": exact_url,
  "name": exact_title,
  "description": exact_description,
  "inLanguage": "en",
  "isPartOf": { "@id": `${site}#website` },
  "publisher": { "@id": `${site}#organization` },
  "about": { "@id": `${site}#person` },
  ...(home ? { "mainEntity": { "@id": `${site}#person` } } : {}),
  "primaryImageOfPage": {
    "@type": "ImageObject",
    "url": exact_image,
  },
}

const exact_breadcrumb = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": breadcrumbItems,
}

const baseSchemas = [exact_person, exact_organization, exact_website, exact_webpage, exact_breadcrumb]
const pageSchemas = schema ? (Array.isArray(schema) ? schema : [schema]) : []
const mergedSchemas = [...baseSchemas, ...pageSchemas]


---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/logos/logo-white.svg" />
<meta name="generator" content={Astro.generator} />

<link rel="preload" href="/fonts/Atkinson-Hyperlegible-Regular-102.woff" as="font" type="font/woff" crossorigin>
<link rel="preload" href="/fonts/Atkinson-Hyperlegible-Bold-102.woff" as="font" type="font/woff" crossorigin>

<!-- Canonical URL -->
<link rel="canonical" href={canonical} />

<!-- Primary Meta Tags -->
<title>{exact_title}</title>
<meta name="title" content={exact_title} />
<meta name="description" content={exact_description} />
{isHiddenPage ? (
  <meta name="robots" content="noindex, nofollow" />
) : (
  <meta name="robots" content="index, follow" />
)}

<!-- Open Graph / Facebook -->
<meta property="og:type" content="website" />
<meta property="og:url" content={exact_url} />
<meta property="og:title" content={exact_title} />
<meta property="og:description" content={exact_description} />
<meta property="og:image" content={exact_image} />

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={exact_url} />
<meta property="twitter:title" content={exact_title} />
<meta property="twitter:description" content={exact_description} />
<meta property="twitter:image" content={exact_image} />

<!-- JSON-LD -->
{mergedSchemas.map((item) => (
  <script type="application/ld+json" is:inline set:html={JSON.stringify(item)} />
))}

<!-- Sitemap -->
<!-- <link rel="sitemap" href="/sitemap-index.xml" /> -->

<!-- RSS Feed -->
<link rel="alternate" type="application/rss+xml" title={exact_title} href={new URL("rss.xml", site).href}/>

<!-- Global Scripts -->
<script is:inline src="/js/theme.js"></script>
<script is:inline src="/js/scroll.js"></script>
<script is:inline src="/js/animate.js"></script>

<ClientRouter  />

<script>
  import type { TransitionBeforeSwapEvent } from "astro:transitions/client"
  document.addEventListener("astro:before-swap", (e) =>
    [
      ...(e as TransitionBeforeSwapEvent).newDocument.head.querySelectorAll(
        "link[as=\"font\"]"
      ),
    ].forEach((link) => link.remove())
  )
</script>
